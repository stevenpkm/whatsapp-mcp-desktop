# You do NOT need this file to use WhatsApp MCP.
# Claude starts the program by itself, and keys (Gemini, OpenAI) are pasted on
# the settings page, never here. These settings are only for developers and
# tests. All of them are optional; leave them out to use the defaults.

# Folder for the WhatsApp link, the encrypted messages and the logs.
# Default: "WhatsApp MCP" in your user folder.
WHATSAPP_MCP_HOME=

# Time zone for the times Claude reads and writes, like Asia/Kuala_Lumpur.
# Default: your computer's time zone.
TIMEZONE=

# Country code put in front of local numbers that start with 0, like 60.
# The settings page overrides it. Default: none.
DEFAULT_COUNTRY_CODE=

# 1 = do not connect to WhatsApp at all (tests with fake data).
WA_OFF=

# 1 = never open the browser by itself (the QR and settings links are still given).
WHATSAPP_MCP_NO_BROWSER=

# 1 = never show desktop alerts.
WHATSAPP_MCP_NO_ALERTS=

# 1 = run the WhatsApp part inside the program Claude starts, instead of in
# the background. Claude Desktop does this by itself; this forces it for tests.
WHATSAPP_MCP_FORCE_INPROCESS=

# Set by the program itself when it runs the WhatsApp part inside, do not set.
WHATSAPP_MCP_INPROCESS=

# Tests only: 1 = write sent messages to a file instead of WhatsApp.
WHATSAPP_MCP_FAKE_SEND=

# Tests only: a fixed gap between sends in milliseconds (default 20 to 60 seconds).
WHATSAPP_MCP_SEND_GAP_MS=

# Where save_file and save_files put files. Default: Downloads/WhatsApp MCP.
WHATSAPP_MCP_DOWNLOADS=

# Other addresses for Google Gemini and OpenAI, only for tests with stand-ins.
# Default: the real services.
WHATSAPP_MCP_GEMINI_URL=
WHATSAPP_MCP_OPENAI_URL=
